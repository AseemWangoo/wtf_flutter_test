# 100ms dashboard → Developer → Access Credentials
HMS_ACCESS_KEY=your_access_key_here
HMS_APP_SECRET=your_app_secret_here

# Video Conferencing template ID (optional for room creation later)
HMS_TEMPLATE_ID=your_template_id_here

# Role names from your 100ms template (Video Conferencing → host / guest)
HMS_ROLE_TRAINER=host
HMS_ROLE_MEMBER=guest

PORT=3000
